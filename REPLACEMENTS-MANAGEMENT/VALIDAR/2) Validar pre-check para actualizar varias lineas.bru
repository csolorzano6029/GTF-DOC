meta {
  name: 2) Validar pre-check para actualizar varias lineas
  type: http
  seq: 2
}

post {
  url: {{host}}/gtfReplacementsServices/api/v1/replenishment-management/40039/details/validate-update
  body: json
  auth: inherit
}

