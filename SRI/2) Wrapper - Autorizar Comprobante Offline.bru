meta {
  name: 2) Wrapper - Autorizar Comprobante Offline
  type: http
  seq: 4
}

post {
  url: {{host}}/gtfReplacementsServices/api/v1/sri/authorize
  body: xml
  auth: inherit
}

body:xml {
  <soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:ec="http://ec.gob.sri.ws.autorizacion">
     <soapenv:Header/>
     <soapenv:Body>
        <ec:autorizacionComprobante>
           <!--Optional:-->
           <claveAccesoComprobante>1108202601131344526200120011000000000183862199811</claveAccesoComprobante>
        </ec:autorizacionComprobante>
     </soapenv:Body>
  </soapenv:Envelope>
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
